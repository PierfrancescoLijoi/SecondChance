# Azure web container (ADR-023). nginx's entrypoint renders ${VARIABLES} from the environment into
# /etc/nginx/conf.d/default.conf. Front Door is the only way in: it forwards the profile id in X-Azure-FDID.
# Security headers live at server level only: an add_header inside a location would drop them.
map $http_x_azure_fdid $edge_ok {
    default 0;
    "${FRONT_DOOR_ID}" 1;
}

server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ${CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${CSP_FORM_ACTION}; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Container Apps probes carry no Front Door id.
    location = /health {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # One build for every environment (web/src/config.ts): the configuration is this container's environment.
    location = /config.json {
        if ($edge_ok = 0) { return 403; }
        default_type application/json;
        expires -1;
        return 200 '${WEB_CONFIG_JSON}';
    }

    # The entry point is never cached (Front Door honours this), so a deployment is visible at once; the
    # hashed files under /assets are immutable.
    location = /index.html {
        if ($edge_ok = 0) { return 403; }
        expires -1;
    }

    location /assets/ {
        if ($edge_ok = 0) { return 403; }
        expires 1y;
    }

    location / {
        if ($edge_ok = 0) { return 403; }
        try_files $uri /index.html;
    }
}
