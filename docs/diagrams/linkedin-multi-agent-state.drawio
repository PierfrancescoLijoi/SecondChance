olor=#545B64;" vertex="1" parent="1"><mxGeometry x="1320" y="985" width="420" height="64" as="geometry"/></mxCell><mxCell id="m_step" value="&lt;b&gt;agent_step&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=16;fontColor=#16191F;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="1080" width="150" height="40" as="geometry"/></mxCell><mxCell id="s_pend" value="pending" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=15;fontColor=#16191F;strokeColor=#3B48CC;fillColor=#E8F0FE;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="1078" width="130" height="44" as="geometry"/></mxCell><mxCell id="s_runn" value="running&lt;br&gt;&lt;i&gt;lease · attempt + 1&lt;/i&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#16191F;strokeColor=#3B48CC;fillColor=#E8F0FE;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="1072" width="210" height="56" as="geometry"/></mxCell><mxCell id="s_ok" value="succeeded" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=15;fontColor=#16191F;strokeColor=#3B48CC;fillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="780" y="1078" width="140" height="44" as="geometry"/></mxCell><mxCell id="s_ko" value="failed" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=15;fontColor=#16191F;strokeColor=#3B48CC;fillColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="1078" width="110" height="44" as="geometry"/></mxCell><mxCell id="me2" value="claim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=#545B64;strokeWidth=2;fontSize=13;fontColor=#16191F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="s_pend" target="s_runn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="me3" value="complete" style="edgeStyle