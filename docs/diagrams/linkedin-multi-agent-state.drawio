70" as="geometry"/></mxCell><mxCell id="re8" value="supervisor plans from" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=#545B64;strokeWidth=2;fontSize=13;fontColor=#16191F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r_exec" target="r_cat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re9" value="tool calls · read-only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=#545B64;strokeWidth=2;fontSize=13;fontColor=#16191F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="r_cat" target="r_mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re10" value="the only write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=#545B64;strokeWidth=2;fontSize=13;fontColor=#16191F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="r_mcp" target="r_prop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_db" value="Aurora PostgreSQL · Row-Level Security · source of truth" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#16191F;strokeColor=#3B48CC;fillColor=#FFFFFF;strokeWidth=2;arcSize=3;verticalAlign=bottom;align=left;fontStyle=1;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;fontColor=#3B48CC;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1140" y="490" width="590" height="260" as="geometry"/></mxCell><mxCell id="t_run" value="&lt;b&gt;agent_run&lt;/b&gt;&lt;hr&gt;status · version&lt;br&gt;steps_used / max &lt;b&gt;12&lt;/b&gt;&lt;br&gt;tokens_used / max &lt;b&gt;60k&lt;/b&gt;&lt;br&gt;deadline_at &lt;b&gt;+10 min&lt;/b&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#16191F;strokeColor=#3B48CC;fillColor=#E8F0FE;str