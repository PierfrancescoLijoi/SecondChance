0" as="geometry"/></mxCell><mxCell id="t0" value="&lt;b&gt;agent_run&lt;/b&gt;&lt;hr&gt;status · version&lt;br&gt;max 12 steps&lt;br&gt;max 60k tokens&lt;br&gt;deadline 10 min" style="rounded=1;arcSize=6;strokeColor=#2F3BB0;fillColor=#E8F0FE;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#16191F;fontStyle=0;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="765" y="608" width="220" height="170" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;agent_step&lt;/b&gt;&lt;hr&gt;UNIQUE (run_id, seq)&lt;br&gt;attempt (fencing)&lt;br&gt;lease_until&lt;br&gt;model · tokens" style="rounded=1;arcSize=6;strokeColor=#2F3BB0;fillColor=#E8F0FE;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#16191F;fontStyle=0;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1025" y="608" width="220" height="170" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;agent_memory&lt;/b&gt;&lt;hr&gt;scope = run&lt;br&gt;(the blackboard)&lt;br&gt;source agent&lt;br&gt;expires_at" style="rounded=1;arcSize=6;strokeColor=#2F3BB0;fillColor=#E8F0FE;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#16191F;fontStyle=0;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1285" y="608" width="220" height="170" as="geometry"/></mxCell><mxCell id="gov_title" value="every turn is governed" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#00806B;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="765" y="826" width="740" height="30" as="geometry"/></mxCell><mxCell id="g0" value="&lt;b&gt;closed catalog&lt;/b&gt;&lt;br&gt;supervisor picks specialists" style="rounded=1;arcSize=6;strokeColor=#00806B;fillColor=#E3F8F4;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#16191F;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="765" y="860" width="220" height="72" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;MCP gateway&lt;/b&gt;&lt;br&gt;read-only tools · audit" style="rounded=1;arcSize=6;strokeColor=#00806B;fillColor=#E3F8F4;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#16191F;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1025" y="860" width="220" height="72" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;pending proposal&lt;/b&gt;&lt;br&gt;a person approves" style="rounded=1;arcSize=6;strokeColor=#00806B;fillColor=#E3F8F4;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#16191F;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1285" y="860" width="220" height="72" as="geometry"/></mxCell><mxCell id="h_left" value="What breaks when state lives in one process" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#C7253E;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="995" width="740" height="40" as="geometry"/></mxCell><mxCell id="h_right" value="How the durable model prevents it" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#5A8A0F;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="840" y="995" width="720" height="40" as="geometry"/></mxCell><mxCell id="bad0" value="&lt;b&gt;1 · Crash or timeout&lt;/b&gt; (Lambda 15 min, pod eviction): the run and everything it learned are lost." style="rounded=1;arcSize=6;strokeColor=#C7253E;fillColor=#FDF1F3;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#16191F;fontStyle=0;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1045" width="740" height="74" as="geometry"/></mxCell><mxCell id="good0" value="&lt;b&gt;1 · Commit after every step&lt;/b&gt;: any instance resumes the run from the last committed seq." style="rounded=1;arcSize=6;strokeColor=#5A8A0F;fillColor=#F5FAEC;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#16191F;fontStyle=0;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="840" y="1045" width="720" height="74" as="geometry"/></mxCell><mxCell id="bad1" value="&lt;b&gt;2 · Retry&lt;/b&gt; after a timeout: the same tool call runs twice, e.g. a double reservation." style="rounded=1;arcSize=6;strokeColor=#C7253E;fillColor=#FDF1F3;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#16191F;fontStyle=0;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1133" width="740" height="74" as="geometry"/></mxCell><mxCell id="good1" value="&lt;b&gt;2 · UNIQUE (run_id, seq) + attempt fencing&lt;/b&gt;: a duplicate is a no-op, a late result is dropped." style="rounded=1;arcSize=6;strokeColor=#5A8A0F;fillColor=#F5FAEC;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#16191F;fontStyle=0;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="840" y="1133" width="720" height="74" as="geometry"/></mxCell><mxCell id="bad2" value="&lt;b&gt;3 · No budget&lt;/b&gt;: a looping model keeps calling itself; tokens and cost are unbounded." style="rounded=1;arcSize=6;strokeColor=#C7253E;fillColor=#FDF1F3;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#16191F;fontStyle=0;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1221" width="740" height="74" as="geometry"/></mxCell><mxCell id="good2" value="&lt;b&gt;3 · Circuit breaker in the commit&lt;/b&gt;: 12 steps · 60k tokens · 10 min, before the next step exists." style="rounded=1;arcSize=6;strokeColor=#5A8A0F;fillColor=#F5FAEC;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#16191F;fontStyle=0;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="840" y="1221" width="720" height="74" as="geometry"/></mxCell><mxCell id="bad3" value="&lt;b&gt;4 · Memory in RAM&lt;/b&gt;: no tenant boundary, no audit trail, sticky sessions." style="rounded=1;arcSize=6;strokeColor=#C7253E;fillColor=#FDF1F3;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#16191F;fontStyle=0;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1309" width="740" height="74" as="geometry"/></mxCell><mxCell id="good3" value="&lt;b&gt;4 · Blackboard in PostgreSQL under RLS&lt;/b&gt;: per tenant and run, with provenance, expiry and audit." style="rounded=1;arcSize=6;strokeColor=#5A8A0F;fillColor=#F5FAEC;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#16191F;fontStyle=0;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="840" y="1309" width="720" height="74" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=none;html=1;strokeColor=#545B64;strokeWidth=2.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=15;fontColor=#16191F;labelBackgroundColor=#FFFFFF;exitX=0.1852;exitY=1;entryX=0.5000;entryY=0;" edge="1" parent="1" source="sup" target="spec0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=none;html=1;strokeColor=#C7253E;strokeWidth=2.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=15;fontColor=#16191F;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 5;exitX=0.5000;exitY=1;entryX=0.1531;entryY=0;" edge="1" parent="1" source="spec0" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="in-process call" style="edgeStyle=none;html=1;strokeColor=#545B64;strokeWidth=2.5;endArrow=block;endFill=1;fontFamily=Helveti