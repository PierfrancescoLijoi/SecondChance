fontStyle=1;fontColor=#FFFFFF;strokeColor=#7AA116;fillColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="1485" y="515" width="30" height="30" as="geometry"/></mxCell><mxCell id="rb3" value="3" style="ellipse;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#FFFFFF;strokeColor=#7AA116;fillColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="1295" y="515" width="30" height="30" as="geometry"/></mxCell><mxCell id="rb4" value="4" style="ellipse;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#FFFFFF;strokeColor=#7AA116;fillColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="1675" y="515" width="30" height="30" as="geometry"/></mxCell><mxCell id="rn0" value="&lt;b&gt;1 · Committed after every step&lt;/b&gt;: any instance resumes the run from the last seq; nothing is lost." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#16191F;strokeColor=#7AA116;fillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="860" y="770" width="430" height="64" as="geometry"/></mxCell><mxCell id="rn1" value="&lt;b&gt;2 · UNIQUE(run_id, seq) + attempt fencing&lt;/b&gt;: a duplicate message finds the step done; a late result is dropped." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#16191F;strokeColor=#7AA116;fillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1310" y="770" width="430" height="64" as="geometry"/></mxCell><mxCell id="rn2" value="&lt;b&gt;3 · Circuit breaker in the commit&lt;/b&gt;: 12 steps · 60k tokens · 10 min, checked before the next step exists." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#16191F;strokeColor=#7AA116;fillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="860" y="842" width="430" height="64" as="geometry"/></mxCell><mxCell id="rn3" value="&lt;b&gt;4 · Blackboard in Postgres under RLS&lt;/b&gt;: per tenant, per run, with provenance, expiry and audit." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#16191F;strokeColor=#7AA116;fillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1310" y="842" width="430" height="64" as="geometry"/></mxCell><mxCell id="m" value="HOW TO MODEL IT · two state machines, one source of truth" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=16;fontColor=#16191F;strokeColor=#3B48CC;fillColor=#FFFFFF;strokeWidth=2;arcSize=3;verticalAlign=top;align=left;fontStyle=1;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;fontColor=#3B48CC;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="945" width="1720" height="205" as="geometry"/></mxCell><mxCell id="m_run" value="&lt;b&gt;agent_run&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=16;fontColor=#16191F;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="1000" width="150" height="40" as="geometry"/></mxCell><mxCell id="s_run" value="running" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=15;fontColor=#16191F;strokeColor=#3B48CC;fillColor=#E8F0FE;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="995" width="130" height="44" as="geometry"/></mxCell><mxCell id="s_term" value="" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=12;fontColor=#16191F;strokeColor=#3B48CC;fillColor=#F7F9FE;strokeWidth=2;arcSize=3;verticalAlign=top;align=left;fontStyle=1;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;fontColor=#3B48CC;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="440" y="985" width="860" height="64" as="geometry"/></mxCell><mxCell id="s_t0" value="succeeded" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=w