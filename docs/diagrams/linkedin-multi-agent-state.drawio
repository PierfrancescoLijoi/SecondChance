<mxfile host="generator"><diagram id="multi-agent-state" name="Multi-agent state"><mxGraphModel dx="1800" dy="1180" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1180" background="#FFFFFF" math="0" shadow="0" defaultFontFamily="Helvetica"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Multi-agent systems: where does the loop keep its state?&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=30;fontColor=#16191F;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="44" as="geometry"/></mxCell><mxCell id="subtitle" value="Same supervisor and specialists, two answers. One survives a crash, a retry and a runaway model; one does not." style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=17;fontColor=#16191F;strokeColor=none;fillColor=none;align=left;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1720" height="30" as="geometry"/></mxCell><mxCell id="p" value="PROBLEM · the supervisor loop lives in one process" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=17;fontColor=#16191F;strokeColor=#DD344C;fillColor=#FFF7F8;strokeWidth=2;arcSize=3;verticalAlign=top;align=left;fontStyle=1;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;fontColor=#DD344C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="760" height="800" as="geometry"/></mxCell><mxCell id="l_user" value="&lt;b&gt;API request&lt;/b&gt;&lt;br&gt;&lt;i&gt;tenant · user · task&lt;/i&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=15;fontColor=#16191F;strokeColor=#4B5563;fillColor=#F3F4F6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="175" width="180" height="56" as="geometry"/></mxCell><mxCell id="l_sup" value="Supervisor process · long-running loop" s