style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=#545B64;strokeWidth=2;fontSize=13;fontColor=#16191F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.8077;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l_sup" target="l_sc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=#DD344C;strokeWidth=2;fontSize=13;fontColor=#16191F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=8 6;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="l_sa" target="l_tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le6" value="direct side effects" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=#DD344C;strokeWidth=2;fontSize=13;fontColor=#16191F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=8 6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l_sb" target="l_tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=#DD344C;strokeWidth=2;fontSize=13;fontColor=#16191F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=8 6;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="l_sc" target="l_tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lb1" value="1" style="ellipse;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#FFFFFF;strokeColor=#DD344C;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="625" y="255" width="30" height="30" as="geometry"/></mxCell><mxCell id="lb3" value="3" style="ellipse;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#FFFFFF;strokeColor=#DD344C;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="105" y="255" width="30" height="30" as="geometry"/></mxCell><mxCell id="lb4" value="4" style="ellipse;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#FFFFFF;strokeColor=#DD344C;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="625" y="395" width="30" height="30" as="geometry"/></mxCell><mxCell id="lb2" value="2" style="ellipse;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#FFFFFF;strokeColor=#DD344C;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="455" y="645" width="30" height="30" as="geometry"/></mxCell><mxCell id="ln0" value="&lt;b&gt;1 · Crash or timeout&lt;/b&gt; (Lambda 15 min, pod eviction): the run and everything it learned are gone." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#16191F;strokeColor=#DD344C;fillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="345" height="68" as="geometry"/></mxCell><mxCell id="ln1" value="&lt;b&gt;2 · Retry&lt;/b&gt; after a timeout: the same tool call runs twice, e.g. a double reservation." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#16191F;strokeColor=#DD344C;fillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="425" y="760" width="345" height="68" as="geometry"/></mxCell><mxCell id="ln2" value="&lt;b&gt;3 · No budget&lt;/b&gt;: a looping model keeps calling itself; tokens and cost are unbounded." style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=14;fontColor=#16191F;strokeColor=#DD344C;fillColor=#FFFFFF;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="838" width="345" height="68" as="geometry"/></mxCell><mxCell id="ln3" value="&lt;b&gt;4 · Memory in RAM&lt;/b&gt;: no tenant boundary, no audit trail, sticky sessions, no scale-out." style="ro